# Frontend build-time configuration.
#
# Copy to `.env.local` and fill in. Every variable here is *built into the
# bundle* — Vite inlines them at build time, so they are readable by anyone who
# loads the page. Nothing secret belongs in this file.

# Where the API lives. Defaults to `/api`, which is correct when the API is
# proxied from the same origin as the SPA (the dev server proxies it, and so does
# a single-host deploy). Set an absolute URL only when the API is on another
# origin — CORS then has to allow the SPA's origin, see `app/main.py`.
VITE_API_BASE_URL=/api

# GA4 measurement id, e.g. `G-XXXXXXXXXX`.
#
# Unset means **no analytics tag is loaded at all**, which is the intended
# default: a tag pointed at a placeholder id still reports page views into
# somewhere, and "somewhere" is usually another team's property. A local run or a
# preview deploy should leave this empty.
#
# Setting it also means the CSP must carry the GA4 origins, and it already does
# (see `vite.config.js` and `CSP_DIRECTIVES` in `app/main.py`). Both halves —
# `script-src` for the tag and `connect-src` for the beacon — were changed
# together, because naming only one loads the tag and then silently drops every
# event.
VITE_GA4_MEASUREMENT_ID=
