# ==============================================================================
# VYAPARI SELLER AGENT MICROSERVICE (.env.example)
# Team B — Agentic Operations Engine (FastAPI + Google Gemini + Celery)
# ==============================================================================

# HTTP Service Configuration
PORT=8002
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Persistence & Least-Privilege Role Isolation
# ------------------------------------------------------------------------------
# Standard database URL (fallback if AGENT_DATABASE_URL is not set):
DATABASE_URL=postgresql://vyapari_admin:vyapari_secure_password@db:5432/vyapari

# Recommended for Production: Segregated Least-Privilege Agent Role
# See db/migrations/V5__agent_privileges.sql
# The 'vyapari_agent' role has SELECT on catalog tables, INSERT on drafts & logs,
# and strictly REVOKED permissions on UPDATE/DELETE on live commerce tables.
AGENT_DATABASE_URL=postgresql://vyapari_agent:vyapari_agent_pass_change_in_prod@db:5432/vyapari

# ------------------------------------------------------------------------------
# Redis — Celery Broker, Result Backend & Distributed Quotas
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Google Gemini LLM Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# AI Budget & Quota Controls (Per-Seller Daily Guardrails)
# ------------------------------------------------------------------------------
# Maximum LLM requests permitted per merchant per calendar day (UTC)
MAX_DAILY_SELLER_AI_REQUESTS=500

# Maximum estimated LLM tokens consumed per merchant per calendar day (UTC)
MAX_DAILY_SELLER_AI_TOKENS=500000

# Conservative In-Memory Safety Throttle when Redis is unavailable (req/min/seller)
LOCAL_FALLBACK_MAX_PER_MINUTE=10
