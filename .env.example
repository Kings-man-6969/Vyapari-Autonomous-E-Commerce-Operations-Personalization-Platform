# ==============================================================================
# VYAPARI PLATFORM CONFIGURATION (.env.example)
# ==============================================================================

# FastAPI Core Backend (Port 8000)
PORT=8000
NODE_ENV=development
API_URL=https://api.vyapari.live
FRONTEND_URL=http://localhost:3000

# PostgreSQL (pgvector 16)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vyapari
POSTGRES_USER=vyapari_admin
POSTGRES_PASSWORD=vyapari_secure_password
DATABASE_URL=postgresql://vyapari_admin:vyapari_secure_password@db:5432/vyapari

# Redis (Caching, Sessions & Rate Limiting — 30MB Budget)
# Local Docker: redis://redis:6379/0
# DigitalOcean Managed Redis: rediss://default:<password>@<host>:<port>
# Upstash: rediss://default:<password>@<host>:<port>
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=
# REDIS_SSL=false

# Authentication & Security
JWT_ACCESS_SECRET=vyapari_jwt_access_secret_sample_key_change_in_production_384b
JWT_REFRESH_SECRET=vyapari_jwt_refresh_secret_sample_key_change_in_production_384b
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway — Razorpay Test Mode (INR native)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder_secret

# Python AI Microservices (Internal Docker network)
RECOMMENDATION_SERVICE_URL=http://service-recommendation:8001
SELLER_AGENT_SERVICE_URL=http://service-seller-agent:8002

# Team B — Google Gemini AI Studio (Seller Intelligence Agents)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-1.5-flash

# Vite Frontend (Port 3000)
VITE_API_BASE_URL=http://localhost:8000/api
